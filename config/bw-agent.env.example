# bw-agent private configuration — TEMPLATE (placeholders only).
#
# Copy to ${XDG_CONFIG_HOME:-~/.config}/bw-agent/default.env and restrict it:
#     install -m 600 config/bw-agent.env.example ~/.config/bw-agent/default.env
# (or run: ./install.sh --init-config). bw-agent refuses group/world-readable files.
#
# Format: KEY=VALUE, one per line. The file is parsed, NEVER sourced: no
# $(...) / ${...} expansion. Text after " #" is a comment, so quote values
# that contain " #". Environment variables override values here.
# Full reference: docs/configuration.md   Schema: config/schema.json

# --- Server ---------------------------------------------------------------
# Any Bitwarden-compatible server: Bitwarden cloud (US/EU), self-hosted
# Bitwarden or Vaultwarden. Leave unset to keep the bw CLI's current server.
BW_SERVER=https://vault.example.com

# --- API key login (Account settings > Security > Keys > View API key) -----
BW_CLIENTID=user.00000000-0000-0000-0000-000000000000
BW_CLIENTSECRET=<your-api-key-client-secret>

# --- Unlock: choose exactly ONE master-password source ----------------------
# 1) Command that prints the password (recommended: OS keyring / pass / etc.)
#BW_PASSWORD_COMMAND=secret-tool lookup service bitwarden account default
#BW_PASSWORD_COMMAND=pass show bitwarden/master
# 2) File (mode 600) whose first line is the password
#BW_PASSWORD_FILE=/path/to/private/bw-master-password
# 3) Plain value (simplest, least safe)
BW_PASSWORD=<your-master-password>

# --- Optional ---------------------------------------------------------------
# Block all vault writes:
#BW_AGENT_READ_ONLY=1
# Keep `bw export` blocked (1 = allow):
#BW_AGENT_ALLOW_EXPORT=0
# 1 = never store the session key on disk:
#BW_AGENT_NO_CACHE=0
#BW_AGENT_CACHE_DIR=/path/to/cache
#BW_AGENT_LOCK_TIMEOUT=60
#BITWARDENCLI_APPDATA_DIR=/path/to/bw-cli-state-for-this-profile
#NODE_EXTRA_CA_CERTS=/path/to/private-ca.pem
#BW_BIN_DIR=/path/to/dir/containing/bw
#BW_HARD_RESET=0
